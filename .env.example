# Safe to commit: leave credential values empty in this file.
# Put your personal development key in .env.local (ignored by Git).
# See README.md → Secrets and local configuration for setup.
# Mac-side checks and scripts/LaunchWithLocalKey.py read .env.local.
# The launcher injects the key only into the Debug app process environment.
# Swift and Xcode do not load dotenv files. Never add one to target/resources,
# Info.plist, build settings, or a shared Xcode scheme.

# The only provider credential planned for the current demo is OpenAI.
OPENAI_API_KEY=
